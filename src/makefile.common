# common makefile directives

CC?=gcc
CXX?=g++
CFLAGS+=-Ibme -Iasm -O3
CXXFLAGS+=$(CFLAGS) -fpermissive

EXE=	$(PREFIX)goattrk2$(SUFFIX) \
	$(PREFIX)sidmonkey$(SUFFIX) \
	$(PREFIX)gt2reloc$(SUFFIX) \
	$(PREFIX)ins2snd2$(SUFFIX) \
	$(PREFIX)sngspli2$(SUFFIX) \
	$(PREFIX)mod2sng$(SUFFIX)

all: $(EXE)

RESID_OBJS=resid/envelope.o resid/extfilt.o resid/filter.o resid/pot.o resid/sid.o resid/wave.o resid/wave6581__ST.o \
resid/wave6581_P_T.o resid/wave6581_PS_.o resid/wave6581_PST.o resid/wave8580__ST.o resid/wave8580_P_T.o \
resid/wave8580_PS_.o resid/wave8580_PST.o resid/voice.o \
resid-fp/envelopefp.o resid-fp/extfiltfp.o resid-fp/filterfp.o resid-fp/potfp.o resid-fp/sidfp.o \
resid-fp/wavefp.o resid-fp/voicefp.o
ASM_OBJS=asm/asmtab.o asm/chnkpool.o asm/expr.o asm/lexyy.o asm/log.o asm/membuf.o asm/membufio.o asm/namedbuf.o asm/parse.o \
asm/pc.o asm/vec.o
BME_OBJS=bme/bme_snd.o bme/bme_io.o bme/bme_end.o bme/bme.o

# Song data, playroutine, sound and file handling shared by the editor and gt2reloc
ENGINE_OBJS=goatdata.o gsong.o gorder.o gpattern.o ginstr.o gtable.o gplay.o gdisplay.o gfile.o ghelp.o \
gsound.o gsid.o grecipe.o ginfo.o gundo.o gaudio.o $(RESID_OBJS) $(ASM_OBJS) $(BME_OBJS)

# GTK user interface
GUI_OBJS=gtkui.o gtkgrid.o gtkpanels.o gtkdialogs.o gtkwav.o gtkmonitor.o gtkinput.o

$(PREFIX)goattrk2$(SUFFIX): $(GUI_OBJS) goattrk2.o greloc.o grender.o ginput.o $(ENGINE_OBJS)
	$(CXX) -o $@ $^ $(LIBS) $(GTK_LIBS)
	strip $@

# Only the GTK user interfaces need the GTK headers (ginput.c needs GLib and
# ALSA, which come with them)
$(GUI_OBJS) ginput.o: CFLAGS+=$(GTK_CFLAGS)
$(GUI_OBJS): gtkui.h goattrk2.h gui.h gundo.h ginfo.h ginput.h

# SidMonkey: its own GTK user interface on the same engine. goattrk2.o
# provides the engine's settings, globals and startup.
SM_OBJS=smui.o smarrange.o smroll.o smsound.o smexport.o smstart.o

$(PREFIX)sidmonkey$(SUFFIX): $(SM_OBJS) goattrk2.o greloc.o grender.o ghost.o garrange.o groll.o ginput.o $(ENGINE_OBJS)
	$(CXX) -o $@ $^ $(LIBS) $(GTK_LIBS)
	strip $@

$(SM_OBJS): CFLAGS+=$(GTK_CFLAGS)
$(SM_OBJS): sm.h goattrk2.h gundo.h ginfo.h ghost.h garrange.h groll.h ginput.h

# gt2reloc includes greloc.c itself
$(PREFIX)gt2reloc$(SUFFIX): gt2reloc.o $(ENGINE_OBJS)
	$(CXX) -DGT2RELOC -o $@ $^ $(LIBS)
	strip $@

gt2reloc.o: greloc.c

$(PREFIX)mod2sng$(SUFFIX): mod2sng.o bme/bme_end.o
	$(CC) -o $@ $^
	strip $@

$(PREFIX)ins2snd2$(SUFFIX): ins2snd2.o bme/bme_end.o
	$(CC) -o $@ $^
	strip $@

$(PREFIX)sngspli2$(SUFFIX): sngspli2.o bme/bme_end.o
	$(CC) -o $@ $^
	strip $@

# Host tools that build the embedded data file (one rule each, so that
# parallel builds don't run two sub-makes at once)
bme/datafile:
	$(MAKE) -C bme datafile

bme/dat2inc:
	$(MAKE) -C bme dat2inc

goattrk2.dat: bme/datafile player.s altplayer.s chargen.bin palette.bin cursor.bin bcursor.bin goattrk2.bmp goattrk2.seq
	./bme/datafile $@ goattrk2.seq

goatdata.c: goattrk2.dat bme/dat2inc
	./bme/dat2inc $< $@

clean:
	$(RM) *.o *~
	$(RM) asm/*.o
	$(RM) bme/*.o
	$(RM) resid/*.o
	$(RM) resid-fp/*.o
	$(RM) $(EXE)
